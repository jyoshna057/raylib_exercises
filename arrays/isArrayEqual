function isArrayEqual(array1, array2) {
    if (array1.length != array2.length) return false;


    for (i = 0; i < array1.length; i++) {
        if (array1[i] != array2[i]) {
            return false;
        }
    }
    return true;
}
console.log(isArrayEqual([1, 2, 3, 4], [1, 2, 3, 4])) //=> true
console.log(isArrayEqual([1, 2, 3], [1, 2, 3, 4])) //=> false
console.log(isArrayEqual([1, 2, 3], [1, 3, 2])) //=> false
console.log(isArrayEqual([1, [22], 3], [1, [22], 3]))// => true